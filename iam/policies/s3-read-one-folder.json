{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SeeTheBucketNames",
      "Effect": "Allow",
      "Action": ["s3:ListAllMyBuckets", "s3:GetBucketLocation", "cloudformation:ListResources"],
      "Resource": "*"
    },
    {
      "Sid": "ListOnlyTheFolderAndTheWayToIt",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET_NAME",
      "Condition": { "StringLike": { "s3:prefix": ["", "FOLDER/", "FOLDER/*"] } }
    },
    {
      "Sid": "ReadOnlyTheFolder",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::BUCKET_NAME/FOLDER/*"
    }
  ]
}
